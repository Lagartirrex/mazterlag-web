# Copiá este archivo a .env y completá los valores. NUNCA subas .env a Git.

PORT=3000
HOST=0.0.0.0

# URL pública de ESTE backend (se usa para armar las URLs de las imágenes)
PUBLIC_URL=http://localhost:3000
# URL pública del sitio web (se usa en los avisos a Discord)
SITE_URL=http://localhost:8000
# Orígenes del sitio que pueden consultar la API (separados por coma). "null" permite abrir el sitio con doble clic.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
# Poné 1 si el backend está detrás de un proxy (Render, Railway, Nginx...) para leer la IP real
TRUST_PROXY=0

# Clave para las rutas de administración (/api/admin/*). Mínimo 24 caracteres. Generá una:  openssl rand -hex 32
ADMIN_TOKEN=

# Carpetas de datos y de imágenes subidas (en producción deben ser un disco persistente)
DATA_DIR=data
UPLOADS_DIR=uploads
# Opcional: carpeta del sitio web para que este mismo servidor lo sirva (ej: ../web)
FRONTEND_DIR=

RATE_LIMIT_PER_MIN=120

# --- Instagram (API de Instagram con inicio de sesión de Instagram) ---
IG_ACCESS_TOKEN=
IG_SYNC_MINUTES=30
IG_MAX_POSTS=12
# Las publicaciones cuyo texto incluya esta etiqueta se importan como builds EN BORRADOR (vos las revisás y publicás). Vacío = no importar
IG_BUILD_TAG=#build
IG_PROFILE_URL=https://www.instagram.com/mazter_lag

# --- Discord ---
# Código de la invitación permanente (lo que va después de discord.gg/)
DISCORD_INVITE_CODE=XebU8vQu2F
# Webhook del canal donde se avisan las guías nuevas (opcional)
DISCORD_WEBHOOK_URL=

# --- Enlaces oficiales (los entrega GET /api/enlaces y los usa el sitio) ---
LINK_DISCORD=https://discord.gg/XebU8vQu2F
LINK_INSTAGRAM=https://www.instagram.com/mazter_lag
LINK_YOUTUBE=https://www.youtube.com/@mazter_lag
LINK_TIKTOK=https://www.tiktok.com/@mazter_lag
